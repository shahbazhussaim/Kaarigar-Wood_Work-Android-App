<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sand_background"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Workshop Inventory"
        android:textColor="@color/teak_dark"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginBottom="24dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvManageProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="80dp"/>

    <TextView
        android:id="@+id/tvEmptyInventory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="No creations in the catalog yet."
        android:gravity="center"
        android:textColor="@color/teak_medium"
        android:visibility="gone"/>

</LinearLayout>
