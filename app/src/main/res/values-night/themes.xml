<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Karigar" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/oak_light</item>
        <item name="colorOnPrimary">@color/teak_dark</item>
        <item name="colorPrimaryContainer">@color/teak_dark</item>
        <item name="colorOnPrimaryContainer">@color/oak_light</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/gold_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Background -->
        <item name="android:windowBackground">@color/md_theme_dark_background</item>
        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="colorSurface">@color/teak_dark</item>
        <item name="colorOnSurface">@color/white</item>
        
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="Widget.Karigar.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/gold_accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.Karigar.Card.Glass" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/glass_dark</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="Widget.Karigar.Card.Wood" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">#232323</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Widget.Karigar.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/glass_dark</item>
        <item name="itemIconTint">@color/oak_light</item>
        <item name="itemTextColor">@color/oak_light</item>
        <item name="itemRippleColor">@color/teak_medium</item>
    </style>
</resources>
